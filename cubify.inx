<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <!-- Name and id of this extension -->
  <name>Cubify</name>
  <id>io.github.phidelux.cubify</id>

  <!-- Dependencies needed by this extension (inkex/Style ship with Inkscape) -->
  <dependency type="executable" location="inx">cubify.py</dependency>

  <!-- Some general hints regarding the image types and bbcode capabilities. -->
  <param name="cubifyHints" type="description">Only accepted image type is SVG. Use [b][/b] for bold, [i][/i] for italic and [color=000000][/color] for colored text. The hex code must not be specified with a hashtag (#).</param>

  <!-- Definition of dialog interface -->
  <param name="cubify_config" type="notebook">
    <page name="cubify_general_settings" gui-text="General Settings">
      <param name="borderColor" type="color" appearance="colorbutton" gui-text="Basic Shape Color: ">0x333333ff</param>
      <param name="logoPath" type="path" mode="file" filetypes="svg" gui-text="Logo path: "></param>
      <param name="logoBgColor" type="color" appearance="colorbutton" gui-text="Logo Background: ">0xffffffff</param>
    </page>
    <page name="cubify_side_i" gui-text="Cube Side I">
      <param name="sideOneIcon" type="path" mode="file" filetypes="svg" gui-text="Title Logo: "></param>
      <param name="sideOneText" type="string" gui-text="Title Text: ">Package Management</param>
      <param name="sideOneTitleColor" type="color" appearance="colorbutton" gui-text="Title Color: ">0x75a928ff</param>
      <param name="sideOneTitleBgColor" type="color" appearance="colorbutton" gui-text="Title Background: ">0xbc1142ff</param>
      <param name="sideOneHint" type="string" gui-text="Hint: ">See the manual for detailed options (man [command]).</param>
      <param name="sideOneHintColor" type="color" appearance="colorbutton" gui-text="Hint Color: ">0xffffffff</param>
      <param name="sideOneHintBgColor" type="color" appearance="colorbutton" gui-text="Hint Background: ">0x000000ff</param>
      <param name="sideOneTextColor" type="color" appearance="colorbutton" gui-text="Text Color: ">0x000000ff</param>
      <param name="sideOneBgColor" type="color" appearance="colorbutton" gui-text="Background: ">0xffffffff</param>

      <param name="sideOneL1" type="string" gui-text=" 1:" />
      <param name="sideOneL2" type="string" gui-text=" 2:" />
      <param name="sideOneL3" type="string" gui-text=" 3:" />
      <param name="sideOneL4" type="string" gui-text=" 4:" />
      <param name="sideOneL5" type="string" gui-text=" 5:" />
      <param name="sideOneL6" type="string" gui-text=" 6:" />
      <param name="sideOneL7" type="string" gui-text=" 7:" />
      <param name="sideOneL8" type="string" gui-text=" 8:" />
      <param name="sideOneL9" type="string" gui-text=" 9:" />
      <param name="sideOneL10" type="string" gui-text="10:" />
      <param name="sideOneL11" type="string" gui-text="11:" />
      <param name="sideOneL12" type="string" gui-text="12:" />
      <param name="sideOneL13" type="string" gui-text="13:" />
      <param name="sideOneL14" type="string" gui-text="14:" />
      <param name="sideOneL15" type="string" gui-text="15:" />
    </page>
    <page name="cubify_side_ii" gui-text="Cube Side II">
      <param name="sideTwoIcon" type="path" mode="file" filetypes="svg" gui-text="Title Logo: "></param>
      <param name="sideTwoText" type="string" gui-text="Title Text: ">Network</param>
      <param name="sideTwoTitleColor" type="color" appearance="colorbutton" gui-text="Title Color: ">0x75a928ff</param>
      <param name="sideTwoTitleBgColor" type="color" appearance="colorbutton" gui-text="Title Background: ">0xbc1142ff</param>
      <param name="sideTwoHintColor" type="color" appearance="colorbutton" gui-text="Hint Color: ">0xffffffff</param>
      <param name="sideTwoHint" type="string" gui-text="Hint: ">See the manual for detailed options (man [command]).</param>
      <param name="sideTwoHintBgColor" type="color" appearance="colorbutton" gui-text="Hint Background: ">0x000000ff</param>
      <param name="sideTwoTextColor" type="color" appearance="colorbutton" gui-text="Text Color: ">0x000000ff</param>
      <param name="sideTwoBgColor" type="color" appearance="colorbutton" gui-text="Background: ">0xffffffff</param>

      <param name="sideTwoL1" type="string" gui-text=" 1:" />
      <param name="sideTwoL2" type="string" gui-text=" 2:" />
      <param name="sideTwoL3" type="string" gui-text=" 3:" />
      <param name="sideTwoL4" type="string" gui-text=" 4:" />
      <param name="sideTwoL5" type="string" gui-text=" 5:" />
      <param name="sideTwoL6" type="string" gui-text=" 6:" />
      <param name="sideTwoL7" type="string" gui-text=" 7:" />
      <param name="sideTwoL8" type="string" gui-text=" 8:" />
      <param name="sideTwoL9" type="string" gui-text=" 9:" />
      <param name="sideTwoL10" type="string" gui-text="10:" />
      <param name="sideTwoL11" type="string" gui-text="11:" />
      <param name="sideTwoL12" type="string" gui-text="12:" />
      <param name="sideTwoL13" type="string" gui-text="13:" />
      <param name="sideTwoL14" type="string" gui-text="14:" />
      <param name="sideTwoL15" type="string" gui-text="15:" />
    </page>
    <page name="cubify_side_iii" gui-text="Cube Side III">
      <param name="sideThreeText" type="string" gui-text="Title Text: ">Permissions</param>
      <param name="sideThreeIcon" type="path" mode="file" filetypes="svg" gui-text="Title Logo: "></param>
      <param name="sideThreeTitleColor" type="color" appearance="colorbutton" gui-text="Title Color: ">0x75a928ff</param>
      <param name="sideThreeTitleBgColor" type="color" appearance="colorbutton" gui-text="Title Background: ">0xbc1142ff</param>
      <param name="sideThreeHint" type="string" gui-text="Hint: ">See the manual for detailed options (man [command]).</param>
      <param name="sideThreeHintColor" type="color" appearance="colorbutton" gui-text="Hint Color: ">0xffffffff</param>
      <param name="sideThreeHintBgColor" type="color" appearance="colorbutton" gui-text="Hint Background: ">0x000000ff</param>
      <param name="sideThreeTextColor" type="color" appearance="colorbutton" gui-text="Text Color: ">0x000000ff</param>
      <param name="sideThreeBgColor" type="color" appearance="colorbutton" gui-text="Background: ">0xffffffff</param>

      <param name="sideThreeL1" type="string" gui-text=" 1:" />
      <param name="sideThreeL2" type="string" gui-text=" 2:" />
      <param name="sideThreeL3" type="string" gui-text=" 3:" />
      <param name="sideThreeL4" type="string" gui-text=" 4:" />
      <param name="sideThreeL5" type="string" gui-text=" 5:" />
      <param name="sideThreeL6" type="string" gui-text=" 6:" />
      <param name="sideThreeL7" type="string" gui-text=" 7:" />
      <param name="sideThreeL8" type="string" gui-text=" 8:" />
      <param name="sideThreeL9" type="string" gui-text=" 9:" />
      <param name="sideThreeL10" type="string" gui-text="10:" />
      <param name="sideThreeL11" type="string" gui-text="11:" />
      <param name="sideThreeL12" type="string" gui-text="12:" />
      <param name="sideThreeL13" type="string" gui-text="13:" />
      <param name="sideThreeL14" type="string" gui-text="14:" />
      <param name="sideThreeL15" type="string" gui-text="15:" />
    </page>
    <page name="cubify_side_iv" gui-text="Cube Side IV">
      <param name="sideFourIcon" type="path" mode="file" filetypes="svg" gui-text="Title Logo: "></param>
      <param name="sideFourText" type="string" gui-text="Title Text: ">System and Screen</param>
      <param name="sideFourTitleColor" type="color" appearance="colorbutton" gui-text="Title Color: ">0x75a928ff</param>
      <param name="sideFourTitleBgColor" type="color" appearance="colorbutton" gui-text="Title Background: ">0xbc1142ff</param>
      <param name="sideFourHint" type="string" gui-text="Hint: ">See the manual for detailed options (man [command]).</param>
      <param name="sideFourHintColor" type="color" appearance="colorbutton" gui-text="Hint Color: ">0xffffffff</param>
      <param name="sideFourHintBgColor" type="color" appearance="colorbutton" gui-text="Hint Background: ">0x000000ff</param>
      <param name="sideFourTextColor" type="color" appearance="colorbutton" gui-text="Text Color: ">0x000000ff</param>
      <param name="sideFourBgColor" type="color" appearance="colorbutton" gui-text="Background: ">0xffffffff</param>

      <param name="sideFourL1" type="string" gui-text=" 1:" />
      <param name="sideFourL2" type="string" gui-text=" 2:" />
      <param name="sideFourL3" type="string" gui-text=" 3:" />
      <param name="sideFourL4" type="string" gui-text=" 4:" />
      <param name="sideFourL5" type="string" gui-text=" 5:" />
      <param name="sideFourL6" type="string" gui-text=" 6:" />
      <param name="sideFourL7" type="string" gui-text=" 7:" />
      <param name="sideFourL8" type="string" gui-text=" 8:" />
      <param name="sideFourL9" type="string" gui-text=" 9:" />
      <param name="sideFourL10" type="string" gui-text="10:" />
      <param name="sideFourL11" type="string" gui-text="11:" />
      <param name="sideFourL12" type="string" gui-text="12:" />
      <param name="sideFourL13" type="string" gui-text="13:" />
      <param name="sideFourL14" type="string" gui-text="14:" />
      <param name="sideFourL15" type="string" gui-text="15:" />
    </page>
    <page name="cubify_side_v" gui-text="Cube Side V">
      <param name="sideFiveIcon" type="path" mode="file" filetypes="svg" gui-text="Title Logo: "></param>
      <param name="sideFiveText" type="string" gui-text="Title Text: ">Directories and Files</param>
      <param name="sideFiveTitleColor" type="color" appearance="colorbutton" gui-text="Title Color: ">0x75a928ff</param>
      <param name="sideFiveTitleBgColor" type="color" appearance="colorbutton" gui-text="Title Background: ">0xbc1142ff</param>
      <param name="sideFiveHint" type="string" gui-text="Hint: ">See the manual for detailed options (man [command]).</param>
      <param name="sideFiveHintColor" type="color" appearance="colorbutton" gui-text="Hint Color: ">0xffffffff</param>
      <param name="sideFiveHintBgColor" type="color" appearance="colorbutton" gui-text="Hint Background: ">0x000000ff</param>
      <param name="sideFiveTextColor" type="color" appearance="colorbutton" gui-text="Text Color: ">0x000000ff</param>
      <param name="sideFiveBgColor" type="color" appearance="colorbutton" gui-text="Background: ">0xffffffff</param>

      <param name="sideFiveL1" type="string" gui-text=" 1:" />
      <param name="sideFiveL2" type="string" gui-text=" 2:" />
      <param name="sideFiveL3" type="string" gui-text=" 3:" />
      <param name="sideFiveL4" type="string" gui-text=" 4:" />
      <param name="sideFiveL5" type="string" gui-text=" 5:" />
      <param name="sideFiveL6" type="string" gui-text=" 6:" />
      <param name="sideFiveL7" type="string" gui-text=" 7:" />
      <param name="sideFiveL8" type="string" gui-text=" 8:" />
      <param name="sideFiveL9" type="string" gui-text=" 9:" />
      <param name="sideFiveL10" type="string" gui-text="10:" />
      <param name="sideFiveL11" type="string" gui-text="11:" />
      <param name="sideFiveL12" type="string" gui-text="12:" />
      <param name="sideFiveL13" type="string" gui-text="13:" />
      <param name="sideFiveL14" type="string" gui-text="14:" />
      <param name="sideFiveL15" type="string" gui-text="15:" />
    </page>
  </param>

  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Python"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">cubify.py</command>
  </script>
</inkscape-extension>
